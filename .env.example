APP_NAME="Model Aggregator Service"

# OpenAI-compatible local / campus model service
MODEL_TESTER_BASE_URL="https://your-openai-compatible-host/v1"
MODEL_TESTER_API_KEY="your_api_key"
MODEL_TESTER_MODELS_PATH="/models"
MODEL_TESTER_CHAT_PATH="/chat/completions"
MODEL_TESTER_MODELS="qwen3.6-27b:latest,batiai/qwen3.6-27b:q4,medgemma:1.5-4b,gemma4:e4b,gemma2:27b,qwen2.5:14b,nomic-embed-text:latest,llama3:latest"

# Gemini key pool
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEYS="key1,key2,key3"
GEMINI_MODELS="gemini-2.5-flash,gemini-2.0-flash,gemini-flash-latest"

# Yunwu GPT-5.5
YUNWU_API_BASE_URL="https://your-yunwu-host"
YUNWU_API_KEY="your_yunwu_key"
YUNWU_GPT55_MODEL="gpt-5.5"
YUNWU_CHAT_PATH="/v1/chat/completions"

# Mathpix
MATHPIX_API_URL="https://api.mathpix.com/v3/text"
MATHPIX_APP_ID="your_mathpix_app_id"
MATHPIX_APP_KEY="your_mathpix_app_key"
MATHPIX_MODEL="mathpix-text"

# Service runtime
AGGREGATOR_HOST="127.0.0.1"
AGGREGATOR_PORT="8890"
REQUEST_TIMEOUT_SECONDS="25"
OCR_CORRECTION_TIMEOUT_SECONDS="90"
OCR_CORRECTION_MAX_OUTPUT_TOKENS="8192"
